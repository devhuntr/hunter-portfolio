{
  "name": "hunter-portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "colorthief": "^2.3.0",
    "lottie-react": "^2.4.0",
    "motion": "^13.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-emoji": "^1.8.1",
    "react-headroom": "^3.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src fetch.js *.mjs",
    "github:refresh": "node fetch.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,mjs,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,jsx,ts,tsx,mjs,css,json,scss}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^8.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^2.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^2.3.1",
    "sass": "^1.32.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  }
}
